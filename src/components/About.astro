---
import { resumeUrl } from '../site';

const milestones = [
  { year: 'Today', text: 'Consultant at Federal Home Loan Bank — rates platform for government banks on Azure.' },
  { year: '2020', text: 'Fractional CTO at CODE Éxitos — digital product studio, 50+ developers in Latin America.' },
  { year: '2018', text: 'Senior Software Engineer at AHEAD — cloud consulting, internal and client platforms.' },
  { year: '2017', text: 'Lead Developer at Akroma — blockchain network, Ethereum fork, smart contracts.' },
  { year: '2016', text: 'Founded TeamVirtuoso — boutique consulting for fintech and blockchain.' },
  { year: '2016', text: 'Director of Professional Services at RightBrain Networks (AWS / cloud-native).' },
  { year: '2015', text: 'Application Architect at Wantify — venture-backed multi-sided marketplace.' },
  { year: '2012', text: 'Senior .NET Software Engineer at Pillar Technology (acquired by Accenture).' },
  { year: '2010', text: 'Developer at Valassis, DiscoverReady, and Grasshopper — SaaS, legal tech, and telephony.' },
  { year: '2006', text: 'Software Engineer at Oakland County government.' },
  { year: '2003', text: 'Database / dev / network roles at J. Walter Thompson and zipForm.' },
  { year: '1999', text: 'Network Engineer II at RDA Group — started building before Y2K.' },
];

const certifications = [
  'Anthropic — Claude in Amazon Bedrock',
  'Anthropic — Claude with Google Vertex',
  'Anthropic — MCP: Advance Topics',
];
---

<section id="about" class="section-rule">
  <div class="mx-auto max-w-7xl px-6 py-24 md:py-32">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="reveal lg:col-span-5">
        <p class="label mb-4 text-accent">03 — About</p>
        <h2 class="display text-4xl text-ink md:text-6xl">
          25+ years.<br />
          <em>Still building.</em>
        </h2>
        <div class="mt-8 space-y-5 text-lg leading-relaxed text-ink-soft">
          <p>
            I started in network engineering and database administration in the late
            '90s. I shipped my first production applications before broadband was
            common. Since then I've worked as a senior engineer, lead, fractional CTO,
            and consultant — building products for governments, Fortune 500 companies,
            and startups.
          </p>
          <p>
            Every wave — web 2.0, mobile, cloud, blockchain, AI — I've shipped real
            software through. I've led teams of 50+, built compliant financial
            platforms, and adopted agentic delivery where it actually helps. I'm not
            selling certainty. I'm offering the judgment you get from watching what
            works, what doesn't, and what almost worked but for one bad decision.
          </p>
          <p>
            I work best with people who want a peer in the room — not a vendor, not a
            deck. Direct, opinionated, and useful from the first call.
          </p>
          <p>
            <a
              href={resumeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="label inline-flex items-center gap-2 text-accent underline decoration-2 underline-offset-4 transition-colors hover:text-ink"
            >
              Download résumé (PDF)
              <span aria-hidden="true">↗</span>
            </a>
          </p>
          <div class="border-t border-rule pt-6">
            <p class="label mb-3 text-ink-faint">Certifications</p>
            <ul class="space-y-2">
              {
                certifications.map((cert) => (
                  <li class="text-ink-soft">{cert}</li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      <div class="reveal reveal-delay-1 lg:col-span-7">
        <p class="label mb-6 text-ink-faint">A rough timeline</p>
        <ol class="relative space-y-1">
          {
            milestones.map((m) => (
              <li class="grid grid-cols-12 gap-4 border-t border-rule py-4">
                <span class="label col-span-3 text-accent sm:col-span-2">{m.year}</span>
                <span class="col-span-9 text-ink-soft sm:col-span-10">{m.text}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
