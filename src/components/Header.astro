---
import { resumeUrl } from '../site';

const navLinks = [
  { href: '#work', label: '01 / How I work' },
  { href: '#range', label: '02 / Range' },
  { href: '#about', label: '03 / About' },
  { href: '#contact', label: '04 / Contact' },
];
---

<header class="sticky top-0 z-50 border-b border-rule bg-paper/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <a href="#" class="flex items-center gap-3 text-ink transition-opacity hover:opacity-70">
      <span class="font-serif text-2xl leading-none">Eric Polerecky</span>
      <span class="hidden label text-ink-faint sm:inline">/ consultant</span>
    </a>
    <nav class="hidden items-center gap-7 md:flex" aria-label="Main navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="label text-ink-soft transition-colors hover:text-accent"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-3">
    <a
      href={resumeUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="label hidden text-ink-soft transition-colors hover:text-accent sm:inline"
    >
      Résumé
    </a>
    <a
      href="#contact"
      class="group flex items-center gap-2 rounded-full border border-ink bg-ink px-4 py-2 text-paper transition-all hover:bg-paper hover:text-ink"
    >
      <span class="relative flex h-2 w-2">
        <span class="pulse-dot absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-green-500"></span>
      </span>
      <span class="label">Available</span>
    </a>
    </div>
  </div>
</header>
